# Copy to scripts/deploy-vps.env and fill in the real values.
# scripts/deploy-vps.env is git-ignored on purpose: this fork is public and the
# VPS address is reachable from the internet on port 22.

# Hostname or IP of the VPS. Prefer the Tailscale MagicDNS name when the machine
# running the deploy is on the tailnet.
DEPLOY_HOST=apps.tail935846.ts.net

# Absolute directory Caddy serves for /pokesleep-tool/. Everything below it is
# deleted and replaced on every deploy.
DEPLOY_REMOTE_DIR=/var/www/pokesleep-tool

# SSH user on the VPS.
DEPLOY_USER=ubuntu

# SSH port.
DEPLOY_PORT=22

# Private key passed to `ssh -i`. Leave empty to rely on ssh-agent or ~/.ssh/config.
DEPLOY_SSH_KEY=~/.ssh/kondate_oci

# Printed after a successful deploy so the result is easy to open.
DEPLOY_VERIFY_URL=https://apps.tail935846.ts.net/pokesleep-tool/
